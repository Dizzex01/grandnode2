{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File \"./.claude/hooks/guard.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -File \"./pw.ps1\"",
            "shell": "powershell"
          }
        ]
      }
    ]
  }
}